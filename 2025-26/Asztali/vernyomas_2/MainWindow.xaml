<Window x:Class="vernyomas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:vernyomas"
        mc:Ignorable="d"
        Title="Vérnyomásmérés" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse Stroke="Black" Fill="Transparent"/>
                                <Ellipse x:Name="CheckedDot" Margin="4" Fill="Black" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckedDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Label Content="Napszak:" FontSize="20px" HorizontalAlignment="Left" Margin="57,78,0,0" VerticalAlignment="Top"/>
        <Label Content="SYS:" FontSize="20px" HorizontalAlignment="Left" Margin="101,180,0,0" VerticalAlignment="Top"/>
        <Label Content="DIA:" FontSize="20px" HorizontalAlignment="Left" Margin="102,234,0,0" VerticalAlignment="Top"/>
        <Label Content="PULSE:" FontSize="20px" HorizontalAlignment="Left" Margin="102,292,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="sys" FontSize="20px" HorizontalAlignment="Left" Margin="184,184,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="88"/>
        <TextBox x:Name="dia" FontSize="20px" HorizontalAlignment="Left" Margin="184,242,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="88"/>
        <TextBox x:Name="pulse" FontSize="20px" HorizontalAlignment="Left" Margin="184,296,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="88"/>
        <Button x:Name="rogzites" Content="Rögzítés" FontSize="30px" HorizontalAlignment="Left" Margin="102,344,0,0" VerticalAlignment="Top" Click="rogzites_Click"/>
        <DatePicker x:Name="datumValaszto" FontSize="20px" HorizontalContentAlignment="Center"  HorizontalAlignment="Left" Margin="57,10,0,0" VerticalAlignment="Top" Height="43" Width="215"/>
        <RadioButton x:Name="reggel" Content="reggel"  FontSize="20px" GroupName="napszak"  HorizontalAlignment="Left" Margin="160,83,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="delben" Content="délben" FontSize="20px" GroupName="napszak" HorizontalAlignment="Left" Margin="160,110,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="este" Content="este" FontSize="20px" GroupName="napszak" HorizontalAlignment="Left" Margin="160,137,0,0" VerticalAlignment="Top"/>
        <Grid>
            <Button x:Name="biztonsagiMentes" Content="Mentés" FontSize="30px" HorizontalAlignment="Left" Margin="245,344,0,0" VerticalAlignment="Top" Click="biztonsagiMentes_Click"/>
        </Grid>

    </Grid>
</Window>
