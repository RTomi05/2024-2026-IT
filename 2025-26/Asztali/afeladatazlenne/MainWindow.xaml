<Window x:Class="afeladatazlenne.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:afeladatazlenne"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="textbox1" FontSize="20px" HorizontalAlignment="Left" Margin="234,113,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="500" TextChanged="textbox1_TextChanged" GotFocus="textbox1_GotFocus"/>
        <Label x:Name="label1" Content="Írj be egy szöveget:" FontSize="20px" HorizontalAlignment="Left" Margin="34,109,0,0" VerticalAlignment="Top"/>
        <Button x:Name="kuldes" Content="Küldés" FontSize="30px" HorizontalAlignment="Left" Margin="438,183,0,0" VerticalAlignment="Top" Click="kuldes_Click"/>
        <Label x:Name="hanyAkarakter" FontSize="30px" HorizontalAlignment="Left" Margin="34,298,0,0" VerticalAlignment="Top"/>
        <Button x:Name="hianyzoA"  Background="red" Content="Ne nyomd meg!" HorizontalAlignment="Left" Margin="111,360,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Label x:Name="aBetuk" FontSize="30px" Content="" HorizontalAlignment="Left" Margin="234,345,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
