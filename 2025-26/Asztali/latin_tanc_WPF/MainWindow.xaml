<Window x:Class="latin_tanc_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:latin_tanc_WPF"
        mc:Ignorable="d"
        Title="Latin táncok" Height="450" Width="800" Background="#FFB2DDFF">
    <Grid>
        <Rectangle x:Name="hatterCimhez" HorizontalAlignment="Center" Height="82" Stroke="Black" VerticalAlignment="Top" Width="800" Fill="#FF66C3B4"/>
        <Label x:Name="cim" HorizontalAlignment="Center" Margin="0,9,0,0" Content="Latin táncok" FontSize="40px" VerticalAlignment="Top" Width="228"  Background="{x:Null}" BorderBrush="{x:Null}"/>
        <Label x:Name="elsoTancLabel" Content="Elsőként bemutatott tánc:" FontSize="20px" HorizontalAlignment="Left" Margin="10,87,0,0" VerticalAlignment="Top"/>
        <Label x:Name="utolsoTancLabel" Content="Utolsóként bemutatott tánc:" FontSize="20px" HorizontalAlignment="Left" Margin="10,129,0,0" VerticalAlignment="Top"/>
        <Label x:Name="elsoTancKiir" Content="" FontStyle="Italic" FontSize="20px" HorizontalAlignment="Left" Margin="273,87,0,0" VerticalAlignment="Top"/>
        <Label x:Name="utolsoTancKiir" Content="" FontStyle="Italic" FontSize="20px" HorizontalAlignment="Left" Margin="273,129,0,0" VerticalAlignment="Top"/>
        <Button x:Name="legtobbTanc" Content="Legtöbb tánc" HorizontalAlignment="Left" Margin="540,166,0,0" VerticalAlignment="Top" Click="legtobbTanc_Click"/>
    </Grid>
</Window>
