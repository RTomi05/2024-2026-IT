<Window x:Class="vernyomas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:vernyomas"
        mc:Ignorable="d"
        Title="Vérnyomásmérés" Height="450" Width="800">
    <Grid>
        <Label Content="A nap sorszáma:" FontSize="20px" HorizontalAlignment="Left" Margin="25,44,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="sorszam" FontSize="20px" HorizontalAlignment="Left" Margin="184,52,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="88"/>
        <Label Content="Napszak:" FontSize="20px" HorizontalAlignment="Left" Margin="57,98,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="napszak" HorizontalAlignment="Left" Margin="184,105,0,0" VerticalAlignment="Top" Width="88">
            <ComboBoxItem Content="Reggel"/>
            <ComboBoxItem Content="Délben"/>
            <ComboBoxItem Content="Este"/>
        </ComboBox>
        <Label Content="SYS:" FontSize="20px" HorizontalAlignment="Left" Margin="101,180,0,0" VerticalAlignment="Top"/>
        <Label Content="DIA:" FontSize="20px" HorizontalAlignment="Left" Margin="102,234,0,0" VerticalAlignment="Top"/>
        <Label Content="PULSE:" FontSize="20px" HorizontalAlignment="Left" Margin="102,292,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="sys" FontSize="20px" HorizontalAlignment="Left" Margin="184,184,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="88"/>
        <TextBox x:Name="dia" FontSize="20px" HorizontalAlignment="Left" Margin="184,242,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="88"/>
        <TextBox x:Name="pulse" FontSize="20px" HorizontalAlignment="Left" Margin="184,296,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="88"/>
        <Button x:Name="rogzites" Content="Rögzítés" FontSize="30px" HorizontalAlignment="Left" Margin="102,344,0,0" VerticalAlignment="Top" Click="rogzites_Click"/>
        <DataGrid d:ItemsSource="{d:SampleData ItemCount=1}" Margin="328,0,0,0" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
            <DataGridTextColumn Header="Nap sorszáma"></DataGridTextColumn>
            <DataGridTextColumn Header="Napszak"></DataGridTextColumn>
            <DataGridTextColumn Header="Szisztolés"></DataGridTextColumn>
            <DataGridTextColumn Header="Diasztolés"></DataGridTextColumn>
            <DataGridTextColumn Header="Pulzus"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
