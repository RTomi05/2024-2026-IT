<Window x:Class="autok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:autok"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TabControl>
            <TabItem Header="2. feladat">
                <Grid Background="Azure">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="335*"/>
                        <ColumnDefinition Width="459*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Legutolsó jeladás:" FontSize="30px" HorizontalAlignment="Left" Margin="51,69,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="utolsoJeladasErtek" HorizontalAlignment="Left" FontSize="30px" Margin="325,77,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="440" IsReadOnly="True" Grid.ColumnSpan="2"/>
                    <Button x:Name="utolsoJeladasLekeres" Content="Lekérés" FontSize="30px" HorizontalAlignment="Left" Margin="333,0,0,0" VerticalAlignment="Center" Click="utolsoJeladasLekeres_Click" Grid.ColumnSpan="2"/>
                </Grid>
            </TabItem>
            <TabItem Header="3. feladat">
                <Grid Background="CadetBlue">
                    <Label Content="Elsőként szereplő jármű jelzései:" FontSize="30px" HorizontalAlignment="Center" Margin="0,36,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="elsokentJarmu" HorizontalAlignment="Center" Margin="0,124,0,0" TextWrapping="Wrap" Text="" FontSize="30px" VerticalAlignment="Top" Width="731" IsReadOnly="True" TextChanged="elsokentJarmu_TextChanged" Height="61"/>
                    <Button x:Name="ElsokentJarmuGomb" FontSize="30px" Content="Lekérés" HorizontalAlignment="Center" Margin="0,226,0,0" VerticalAlignment="Top" Click="ElsokentJarmuGomb_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="4. feladat">
                <Grid Background="CadetBlue">
                    <Label Content="Adjon meg egy időpontot:" FontSize="30px" HorizontalAlignment="Left" Margin="49,10,0,0" VerticalAlignment="Top"/>
                    <TextBox TextAlignment="Center" x:Name="oraInput" HorizontalAlignment="Left" Margin="149,91,0,0" TextWrapping="Wrap" Text="" FontSize="30px" VerticalAlignment="Top" Width="131" TextChanged="elsokentJarmu_TextChanged" Height="61"/>
                    <TextBox TextAlignment="Center" x:Name="percInput" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" FontSize="30px" VerticalAlignment="Top" Width="131" TextChanged="elsokentJarmu_TextChanged" Height="61" Margin="149,191,0,0"/>
                    <Button x:Name="idopontLekeres" Content="Lekérés" FontSize="30px" HorizontalAlignment="Center" Margin="0,152,0,0" VerticalAlignment="Top" Click="idopontLekeres_Click_1"/>
                    <Label Content="Jeladások száma:" FontSize="30px" HorizontalAlignment="Left" Margin="32,297,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="jeladasSzam" FontSize="30px" HorizontalAlignment="Left" Margin="298,305,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" TextChanged="jeladasSzam_TextChanged" IsReadOnly="True"/>
                    <Label Content="Óra:" FontSize="30px" HorizontalAlignment="Left" Margin="49,97,0,0" VerticalAlignment="Top"/>
                    <Label Content="Perc:" FontSize="30px" HorizontalAlignment="Left" Margin="49,197,0,0" VerticalAlignment="Top"/>
                </Grid>
            </TabItem>
            <TabItem Header="5. feladat">
                <Grid Background="CadetBlue">
                    <Label Content="Legnagyobb sebesség:" FontSize="30px" HorizontalAlignment="Left" Margin="23,26,0,0" VerticalAlignment="Top"/>
                    <Label x:Name="maxSebessegErtek" Content="" FontSize="30px" HorizontalAlignment="Left" Margin="338,26,0,0" VerticalAlignment="Top"/>
                    <Button x:Name="legnagyobbSebesseg" Content="Lekérés" FontSize="30px" HorizontalAlignment="Left" Margin="543,32,0,0" VerticalAlignment="Top" Click="Button_Click"/>
                    <TextBox x:Name="legnagyobbalMent" FontSize="30px" HorizontalAlignment="Center" Margin="0,169,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="372"/>
                    <Label Content="A járművek:" FontSize="30px" HorizontalAlignment="Left" Margin="23,165,0,0" VerticalAlignment="Top"/>
                </Grid>
            </TabItem>
            <TabItem Header="6. feladat">
                <Grid Background="CadetBlue">
                    <Label Content="Kérem, adja meg a rendszámot:" FontSize="30px" HorizontalAlignment="Left" Margin="26,54,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="rendszamBeir" HorizontalAlignment="Left" Margin="500,58,0,0" FontSize="30px" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="212"/>
                    <Button x:Name="rendszamLekeres" Content="Lekérés" FontSize="30px" HorizontalAlignment="Left" Margin="554,134,0,0" VerticalAlignment="Top" Click="rendszamLekeres_Click"/>
                    <Label x:Name="rendszamJelzesei" Content="" HorizontalAlignment="Left" Margin="127,199,0,0" VerticalAlignment="Top"/>
                </Grid>
            </TabItem>
            <TabItem Header="7. feladat">
                <Grid Background="Yellow">
                    <Button x:Name="fajlLetrehozGomb" Content="JAJ!" FontSize="90px" Background="Red" HorizontalAlignment="Center" VerticalAlignment="Center" Width="240" Click="fajlLetrehozGomb_Click"/>
                    <Label x:Name="fajlVisszajelez" Content="" FontSize="30px" FontStyle="Oblique"  HorizontalAlignment="Center" Margin="0,308,0,0" VerticalAlignment="Top"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
